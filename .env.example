# ── Public / client-exposed (safe to ship in the browser bundle) ──────────────
# HTTPS endpoints only. Copy these from your Neon project's Auth / Data API settings.
NEXT_PUBLIC_NEON_AUTH_URL=https://your-project.neon.tech/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://your-project.neon.tech/rest/v1

# ── Server-only secrets ────────────────────────────────────────────────────────
# NEVER referenced outside lib/server/** and app/api/**/route.ts.
# NEVER prefix these with NEXT_PUBLIC_ or they will be bundled into client code.

# Raw Postgres connection string. Used only for running db/schema.sql and
# db/rls_policies.sql (migrations) — never for per-request app queries.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Base URL of your Neon Auth instance (used server-side by createNeonAuth).
NEON_AUTH_BASE_URL=https://your-project.neon.tech

# Secret for signing session cookies. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-a-long-random-string-at-least-32-chars
